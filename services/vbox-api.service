[Unit]
Description=GAR — VBox API Server (REST API para VBoxManage)
Documentation=https://github.com/adriandpr84/pxe
After=network.target

[Service]
Type=simple
# IMPORTANTE: se ejecuta como el usuario del Host para tener acceso a VirtualBox.
# VBoxManage necesita el entorno del usuario (no root) para encontrar las VMs.
# La ruta al script se actualiza automáticamente al instalar con el script host_service.sh.
ExecStart=/usr/bin/python3 REPO_PATH/vbox_api_server.py

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vbox-api

[Install]
WantedBy=default.target
