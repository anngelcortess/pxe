#cloud-config
autoinstall:
  version: 1
  locale: es_ES.UTF-8
  keyboard:
    layout: es
  refresh-installer:
    update: false
  identity:
    hostname: {{ HOSTNAME }}
    username: admin
    password: "$6$CylgQV.8wYk/VUlE$UpXhP0y5NrH3ZypUfNvOF2/JEu5rRedFbseqWxsJ/dN0.XjeiK9ho.e78NWOysq/4o19qn1MolUcccrIyCjj5."
    realname: Administrator
  ssh:
    install-server: true
    authorized-keys:
      - "{{ SSH_PUB_KEY }}"
    allow-pw: true
  network:
    version: 2
    ethernets:
{{ INTERFACES_CONFIG }}
  storage:
    layout:
      name: direct
  updates: security
  late-commands:
    # Deshabilitar actualizaciones automáticas en segundo plano para evitar bloqueos de apt-get
    - "curtin in-target systemctl disable apt-daily.timer apt-daily-upgrade.timer"
    - "curtin in-target systemctl disable unattended-upgrades.service"
    # Opcional: Desactivar swap (requerido para Kubernetes, no daña si se usa Swarm)
    - "curtin in-target swapoff -a"
    - "curtin in-target sed -i '/swap/d' /etc/fstab"
