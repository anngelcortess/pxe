[Unit]
Description=GAR Provisioning Coordinator (Orchestrator Daemon)
Documentation=https://github.com/jorgeGimene/gar
After=network-online.target apache2.service
Wants=network-online.target

[Service]
Type=simple
# Ejecutar como root para poder escribir en /srv/tftp y lanzar Ansible con la clave de root
User=root
Group=root

# Ruta al script de callback — ajustar si el repositorio está en otra ubicación
ExecStart=/usr/bin/python3 /home/admin/gar/provisioner.py listen-callbacks

# Reiniciar si el proceso muere inesperadamente
Restart=on-failure
RestartSec=5s

# Logs al journal de systemd (ver con: journalctl -u provisioning-coordinator -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=provisioning-coordinator

[Install]
WantedBy=multi-user.target
