#cloud-config
autoinstall:
  version: 1
  locale: es_ES.UTF-8
  keyboard:
    layout: es
  refresh-installer:
    update: false
  identity:
    hostname: {{ HOSTNAME }}
    username: admin
    password: "$6$CylgQV.8wYk/VUlE$UpXhP0y5NrH3ZypUfNvOF2/JEu5rRedFbseqWxsJ/dN0.XjeiK9ho.e78NWOysq/4o19qn1MolUcccrIyCjj5."
    realname: Administrator
  ssh:
    install-server: true
    authorized-keys:
      - "{{ SSH_PUB_KEY }}"
    allow-pw: true
  network:
    version: 2
    ethernets:
{{ INTERFACES_CONFIG }}
  storage:
    layout:
      name: direct
  updates: security
  late-commands:
    - "curtin in-target systemctl disable apt-daily.timer apt-daily-upgrade.timer"
    - "curtin in-target systemctl disable unattended-upgrades.service"
    # Notificar al jumpstart que la instalación ha terminado (anti-loop PXE + lanzar Ansible)
    - "curl -sf http://{{ JUMPSTART_IP }}:8081/node-ready?node={{ HOSTNAME }} || true"
  power_state:
    mode: poweroff
    condition: True
